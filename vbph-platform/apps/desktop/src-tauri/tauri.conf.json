{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Virtual Bridge PH Time Tracker",
  "version": "0.1.0",
  "identifier": "com.virtualbridgeph.timetracker",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Virtual Bridge PH Time Tracker",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3000 http://127.0.0.1:54321 https://vbph-platform.vercel.app https://vvgddcqetxqvwtbdvkus.supabase.co ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
